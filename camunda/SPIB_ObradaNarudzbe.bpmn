<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_SPIB_ObradaNarudzbe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.47.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:collaboration id="Collaboration_SPIB">
    <bpmn:participant id="Participant_SPIB" name="SPIB — obrada narudzbe" processRef="SPIB_ObradaNarudzbe" />
  </bpmn:collaboration>
  <bpmn:process id="SPIB_ObradaNarudzbe" name="SPIB Obrada narudzbe" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_SPIB">
      <bpmn:lane id="Lane_Kupac" name="Kupac">
        <bpmn:flowNodeRef>Start_Proces</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NovaNarudzbaKupac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IspravakKupac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_RokIspravka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Djelatnik" name="Djelatnik">
        <bpmn:flowNodeRef>Task_PregledDjelatnik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DjelatnikOdluka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Potvrdena</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Administrator" name="Administrator">
        <bpmn:flowNodeRef>Gateway_AdminOdluka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Otkazana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OdlukaAdmin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Proces" name="Start procesa">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="kupacUsername" label="Kupac (Camunda user id)" type="string" defaultValue="kupac1" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_NovaNarudzba</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_NovaNarudzbaKupac" name="Nova narudzba" camunda:assignee="${kupacUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="narudzbaId" label="ID narudzbe" type="long" />
          <camunda:formField id="adresaDostave" label="Adresa dostave" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_NovaNarudzba</bpmn:incoming>
      <bpmn:outgoing>Flow_NovaNarudzba_Pregled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PregledDjelatnik" name="Pregled narudzbe" camunda:candidateGroups="djelatnik">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="odlukaDjelatnika" label="Odluka djelatnika" type="enum">
            <camunda:value id="POTVRDI" name="Potvrdi" />
            <camunda:value id="ESKALIRAJ" name="Eskaliraj adminu" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NovaNarudzba_Pregled</bpmn:incoming>
      <bpmn:incoming>Flow_Ispravak_PonovnoPregled</bpmn:incoming>
      <bpmn:outgoing>Flow_Pregled_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DjelatnikOdluka" name="Adresa OK?">
      <bpmn:incoming>Flow_Pregled_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Potvrdi</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eskaliraj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AdminOdluka" name="Admin odluka">
      <bpmn:incoming>Flow_Admin_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Otkazi</bpmn:outgoing>
      <bpmn:outgoing>Flow_VratiKupcu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Otkazana" name="Narudzba otkazana">
      <bpmn:incoming>Flow_Otkazi</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_Otkaz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_IspravakKupac" name="Ispravak adrese" camunda:assignee="${kupacUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="novaAdresa" label="Nova adresa dostave" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_VratiKupcu</bpmn:incoming>
      <bpmn:outgoing>Flow_Ispravak_PonovnoPregled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Start_NovaNarudzba" sourceRef="Start_Proces" targetRef="Task_NovaNarudzbaKupac" />
    <bpmn:sequenceFlow id="Flow_NovaNarudzba_Pregled" sourceRef="Task_NovaNarudzbaKupac" targetRef="Task_PregledDjelatnik" />
    <bpmn:sequenceFlow id="Flow_Pregled_Gateway" sourceRef="Task_PregledDjelatnik" targetRef="Gateway_DjelatnikOdluka" />
    <bpmn:sequenceFlow id="Flow_Potvrdi" name="Potvrdi" sourceRef="Gateway_DjelatnikOdluka" targetRef="End_Potvrdena">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${odlukaDjelatnika == 'POTVRDI'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Eskaliraj" name="Eskaliraj adminu" sourceRef="Gateway_DjelatnikOdluka" targetRef="Task_OdlukaAdmin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${odlukaDjelatnika == 'ESKALIRAJ'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Admin_Gateway" sourceRef="Task_OdlukaAdmin" targetRef="Gateway_AdminOdluka" />
    <bpmn:sequenceFlow id="Flow_Otkazi" name="Otkazi" sourceRef="Gateway_AdminOdluka" targetRef="End_Otkazana">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${odlukaAdmina == 'OTKAZI'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_VratiKupcu" name="Vrati kupcu" sourceRef="Gateway_AdminOdluka" targetRef="Task_IspravakKupac">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${odlukaAdmina == 'VRATI_KUPCU'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ispravak_PonovnoPregled" name="Ponovni pregled" sourceRef="Task_IspravakKupac" targetRef="Task_PregledDjelatnik" />
    <bpmn:boundaryEvent id="Timer_RokIspravka" name="Rok istekao (7 dana)" attachedToRef="Task_IspravakKupac" cancelActivity="true">
      <bpmn:outgoing>Flow_Timer_Otkaz</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_RokIspravka">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Timer_Otkaz" sourceRef="Timer_RokIspravka" targetRef="End_Otkazana" />
    <bpmn:endEvent id="End_Potvrdena" name="Narudzba potvrdena">
      <bpmn:incoming>Flow_Potvrdi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_OdlukaAdmin" name="Odluka administratora" camunda:candidateGroups="administrator">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="odlukaAdmina" label="Odluka administratora" type="enum">
            <camunda:value id="OTKAZI" name="Otkazi narudzbu" />
            <camunda:value id="VRATI_KUPCU" name="Vrati kupcu na doradu" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Eskaliraj</bpmn:incoming>
      <bpmn:outgoing>Flow_Admin_Gateway</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SPIB">
    <bpmndi:BPMNPlane id="BPMNPlane_SPIB" bpmnElement="Collaboration_SPIB">
      <bpmndi:BPMNShape id="Participant_SPIB_di" bpmnElement="Participant_SPIB" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1180" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Administrator_di" bpmnElement="Lane_Administrator" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="1150" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Djelatnik_di" bpmnElement="Lane_Djelatnik" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="1150" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kupac_di" bpmnElement="Lane_Kupac" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1150" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Proces_di" bpmnElement="Start_Proces">
        <dc:Bounds x="232" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="218" y="195" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NovaNarudzbaKupac_di" bpmnElement="Task_NovaNarudzbaKupac">
        <dc:Bounds x="310" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PregledDjelatnik_di" bpmnElement="Task_PregledDjelatnik">
        <dc:Bounds x="480" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DjelatnikOdluka_di" bpmnElement="Gateway_DjelatnikOdluka" isMarkerVisible="true">
        <dc:Bounds x="635" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="618" y="285" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AdminOdluka_di" bpmnElement="Gateway_AdminOdluka" isMarkerVisible="true">
        <dc:Bounds x="715" y="485" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Otkazana_di" bpmnElement="End_Otkazana">
        <dc:Bounds x="992" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="968" y="535" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IspravakKupac_di" bpmnElement="Task_IspravakKupac">
        <dc:Bounds x="690" y="125" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_RokIspravka_di" bpmnElement="Timer_RokIspravka">
        <dc:Bounds x="722" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="699" y="223" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Potvrdena_di" bpmnElement="End_Potvrdena">
        <dc:Bounds x="952" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="946" y="365" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OdlukaAdmin_di" bpmnElement="Task_OdlukaAdmin">
        <dc:Bounds x="520" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_NovaNarudzba_di" bpmnElement="Flow_Start_NovaNarudzba">
        <di:waypoint x="268" y="170" />
        <di:waypoint x="310" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NovaNarudzba_Pregled_di" bpmnElement="Flow_NovaNarudzba_Pregled">
        <di:waypoint x="360" y="210" />
        <di:waypoint x="360" y="340" />
        <di:waypoint x="480" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Pregled_Gateway_di" bpmnElement="Flow_Pregled_Gateway">
        <di:waypoint x="580" y="340" />
        <di:waypoint x="635" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Potvrdi_di" bpmnElement="Flow_Potvrdi">
        <di:waypoint x="685" y="340" />
        <di:waypoint x="952" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="815" y="322" width="35" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Eskaliraj_di" bpmnElement="Flow_Eskaliraj">
        <di:waypoint x="660" y="365" />
        <di:waypoint x="660" y="440" />
        <di:waypoint x="570" y="440" />
        <di:waypoint x="570" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="579" y="423" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Admin_Gateway_di" bpmnElement="Flow_Admin_Gateway">
        <di:waypoint x="620" y="510" />
        <di:waypoint x="715" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Otkazi_di" bpmnElement="Flow_Otkazi">
        <di:waypoint x="765" y="510" />
        <di:waypoint x="992" y="510" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="864" y="492" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VratiKupcu_di" bpmnElement="Flow_VratiKupcu">
        <di:waypoint x="740" y="485" />
        <di:waypoint x="740" y="205" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="746" y="363" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ispravak_PonovnoPregled_di" bpmnElement="Flow_Ispravak_PonovnoPregled">
        <di:waypoint x="690" y="165" />
        <di:waypoint x="440" y="165" />
        <di:waypoint x="440" y="300" />
        <di:waypoint x="480" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="444" y="147" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timer_Otkaz_di" bpmnElement="Flow_Timer_Otkaz">
        <di:waypoint x="758" y="205" />
        <di:waypoint x="850" y="205" />
        <di:waypoint x="850" y="510" />
        <di:waypoint x="992" y="510" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
